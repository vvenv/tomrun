# Tomrun 官网 + 全服纪录榜 — run.edao.plus
upstream tomrun_leaderboard {
    server 127.0.0.1:8787;
    keepalive 4;
}

server {
    listen 443 ssl;
    server_name run.edao.plus;

    ssl_certificate /etc/letsencrypt/live/run.edao.plus/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/run.edao.plus/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/run.edao.plus;
    index index.html;

    client_max_body_size 64k;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 256;

    location /api/ {
        proxy_pass http://tomrun_leaderboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location ^~ /downloads/ {
        default_type application/vnd.android.package-archive;
        add_header Content-Disposition "attachment";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options "nosniff" always;
}

server {
    listen 80;
    server_name run.edao.plus;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
