# 可选：旧域名兼容。等 run.edao.plus 的 DNS 指到本机、并用 certbot 签出旧域名证书后，
# 装到 /etc/nginx/sites-available/run.edao.plus 并软链到 sites-enabled。
# 依赖 run.wenfu.dev 配置里定义的 upstream tomrun_leaderboard。
#
# 旧域名 run.edao.plus：已发出去的 APK 把 https://run.edao.plus 编进了
# LEADERBOARD_API_BASE，所以 /api/ 必须原样反代（POST 经 301 会丢请求体），
# 旧证书也得留着。其余路径 301 到新域名。
server {
    listen 443 ssl;
    server_name run.edao.plus;

    ssl_certificate /etc/letsencrypt/live/run.edao.plus/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/run.edao.plus/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 64k;

    location /api/ {
        proxy_pass http://tomrun_leaderboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location / {
        return 301 https://run.wenfu.dev$request_uri;
    }
}

server {
    listen 80;
    server_name run.edao.plus;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://run.wenfu.dev$request_uri;
    }
}
